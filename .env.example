# Use scripts/init-env.sh to create a private .env with random local credentials.
# Compose reads .env. Go commands read exported environment variables only.
HACKBOX_ENV=development
HACKBOX_HTTP_ADDR=127.0.0.1:8080
HACKBOX_PORT=8080
HACKBOX_PUBLIC_ORIGIN=http://127.0.0.1:8080
HACKBOX_LOG_LEVEL=INFO
HACKBOX_MAX_BODY_BYTES=16777216
HACKBOX_REQUEST_TIMEOUT=10s
HACKBOX_SHUTDOWN_TIMEOUT=20s
HACKBOX_FILE_MAX_BYTES=8388608
HACKBOX_FILE_EVENT_QUOTA=1073741824
HACKBOX_DB_PASSWORD=
HACKBOX_METRICS_TOKEN=

# Configure an exact tenant-specific OIDC issuer and register
# <HACKBOX_PUBLIC_ORIGIN>/auth/callback as the redirect URI.
HACKBOX_OIDC_ISSUER=
HACKBOX_OIDC_CLIENT_ID=
HACKBOX_OIDC_CLIENT_SECRET=
# Stable OIDC subject (not email) for the first platform administrator.
# Remove after the first successful administrator login.
HACKBOX_BOOTSTRAP_SUBJECT=

# For Go development outside Compose, also export HACKBOX_DATABASE_URL.
# HACKBOX_DATABASE_URL='postgres://user:password@127.0.0.1:5432/hackbox?sslmode=disable'
# HACKBOX_STORAGE_PATH=data/files
# HACKBOX_WEB_DIR=web/dist
